{
  "name": "banking-exam-preparation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:full": "concurrently -k -n API,WEB \"npm:dev:server\" \"npm:dev\"",
    "start:server": "tsx server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed-admin": "tsx server/seed-admin.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "build": "tsc -b && npm run typecheck:server && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "latest",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "read-excel-file": "^9.3.14",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.6"
  }
}
